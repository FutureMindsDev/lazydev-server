FROM python:3.11.18-slim

# Install system dependencies
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    ssh \
    sudo \
    build-essential \
    zip \
    unzip \
    sed \
    xz-utils \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install pipx and uv (pinned)
ARG PIPX_VERSION=1.18.4
ARG UV_VERSION=0.13.6
RUN pip install --no-cache-dir "pipx==${PIPX_VERSION}" "uv==${UV_VERSION}"
ENV PATH="/root/.local/bin:${PATH}"

# Install Node.js (pinned) + TypeScript language tooling (pinned)
ARG NODE_VERSION=22.23.4
ARG TYPESCRIPT_VERSION=7.0.2
ARG TYPESCRIPT_LANGUAGE_SERVER_VERSION=6.0.2
RUN ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "arm64" ]; then NODE_ARCH=arm64; else NODE_ARCH=x64; fi && \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" && \
    tar -xJf "node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" -C /usr/local --strip-components=1 && \
    rm "node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" && \
    npm install -g "typescript@${TYPESCRIPT_VERSION}" "typescript-language-server@${TYPESCRIPT_LANGUAGE_SERVER_VERSION}"

# Install Go (pinned) and gopls (pinned)
ARG GO_VERSION=1.27.3
ARG GOPLS_VERSION=v0.24.0
RUN ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "arm64" ]; then \
    curl -fsSLO "https://go.dev/dl/go${GO_VERSION}.linux-arm64.tar.gz" && \
    tar -C /usr/local -xzf "go${GO_VERSION}.linux-arm64.tar.gz" && \
    rm "go${GO_VERSION}.linux-arm64.tar.gz"; \
    else \
    curl -fsSLO "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" && \
    tar -C /usr/local -xzf "go${GO_VERSION}.linux-amd64.tar.gz" && \
    rm "go${GO_VERSION}.linux-amd64.tar.gz"; \
    fi
ENV PATH=$PATH:/usr/local/go/bin
RUN CGO_ENABLED=0 go install "golang.org/x/tools/gopls@${GOPLS_VERSION}"
ENV PATH=$PATH:/root/go/bin

# Install Rust & rust-analyzer (pinned)
ARG RUST_VERSION=1.99.1
ENV PATH="/root/.cargo/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain "${RUST_VERSION}" \
    && rustup component add rust-analyzer --toolchain "${RUST_VERSION}"

# Clone and install Serena (pinned)
ARG SERENA_VERSION=v2.1.0
WORKDIR /app
RUN git clone --branch "${SERENA_VERSION}" --depth 1 https://github.com/oraios/serena.git . \
    && uv venv \
    && uv sync --frozen --no-dev

# Configure Serena (disable GUI and dashboard, use classic tools interface)
ENV SERENA_HOME=/app/config
RUN mkdir -p $SERENA_HOME \
    && cp src/serena/resources/serena_config.template.yml $SERENA_HOME/serena_config.yml \
    && sed -i 's/gui_log_window:.*/gui_log_window: False/' $SERENA_HOME/serena_config.yml \
    && sed -i 's/web_dashboard_open_on_launch:.*/web_dashboard_open_on_launch: False/' $SERENA_HOME/serena_config.yml \
    && sed -i 's/web_dashboard_listen_address:.*/web_dashboard_listen_address: "0.0.0.0"/' $SERENA_HOME/serena_config.yml \
    && sed -i 's/agent_interface: REPL/agent_interface: tools/' $SERENA_HOME/serena_config.yml \
    && sed -i '/markdown:/,+5d' $SERENA_HOME/serena_config.yml

# Expose the port for the MCP Streamable HTTP server
EXPOSE 3333

# Use the virtual environment
ENTRYPOINT ["/bin/bash", "-c", "source .venv/bin/activate && $0 $@"]

# Command to run the Serena agent in Streamable HTTP mode, bound to all interfaces
CMD ["serena-agent", "start-mcp-server", "--transport", "streamable-http", "--port", "3333", "--host", "0.0.0.0"]
